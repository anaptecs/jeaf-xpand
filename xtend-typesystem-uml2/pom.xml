<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>com.anaptecs.jeaf.xpand</groupId>
		<artifactId>jeaf-xpand-project</artifactId>
		<version>3.0.0-SNAPSHOT</version>
	</parent>

	<artifactId>xtend-typesystem-uml2</artifactId>
	<name>JEAF Xpand - UML2 Type System</name>
	<description>UML2 type system incl. UML profiles for Xpand / Xtend (based on Eclipse Xtend 2.2.0).</description>

	<dependencies>
		<dependency>
			<groupId>com.anaptecs.jeaf.xpand</groupId>
			<artifactId>xtend-typesystem-emf</artifactId>
		</dependency>
		<dependency>
			<groupId>com.anaptecs.jeaf.xpand</groupId>
			<artifactId>xtend</artifactId>
		</dependency>
		<dependency>
			<groupId>org.eclipse.emf</groupId>
			<artifactId>org.eclipse.emf.mwe.core</artifactId>
		</dependency>
		<dependency>
			<groupId>commons-logging</groupId>
			<artifactId>commons-logging</artifactId>
		</dependency>
		<dependency>
			<groupId>com.anaptecs.jeaf.owalibs</groupId>
			<artifactId>org.eclipse.emf.common</artifactId>
		</dependency>
		<dependency>
			<groupId>com.anaptecs.jeaf.owalibs</groupId>
			<artifactId>org.eclipse.emf.ecore</artifactId>
		</dependency>
		<dependency>
			<groupId>com.anaptecs.jeaf.owalibs</groupId>
			<artifactId>org.eclipse.emf.mapping.ecore2xml</artifactId>
		</dependency>
		<dependency>
			<groupId>com.anaptecs.jeaf.owalibs</groupId>
			<artifactId>org.eclipse.uml2.common</artifactId>
		</dependency>
		<dependency>
			<groupId>com.anaptecs.jeaf.owalibs</groupId>
			<artifactId>org.eclipse.uml2.uml</artifactId>
		</dependency>
		<dependency>
			<groupId>com.anaptecs.jeaf.owalibs</groupId>
			<artifactId>org.eclipse.uml2.uml.resources</artifactId>
		</dependency>
		<dependency>
			<groupId>com.anaptecs.jeaf.owalibs</groupId>
			<artifactId>org.eclipse.core.runtime</artifactId>
		</dependency>
		<dependency>
			<groupId>com.anaptecs.jeaf.owalibs</groupId>
			<artifactId>org.eclipse.equinox.common</artifactId>
		</dependency>
		<dependency>
			<groupId>com.anaptecs.jeaf.owalibs</groupId>
			<artifactId>org.eclipse.equinox.registry</artifactId>
		</dependency>
		<dependency>
			<groupId>com.anaptecs.jeaf.owalibs</groupId>
			<artifactId>org.eclipse.osgi</artifactId>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<version>${maven-dependency-plugin.version}</version>
				<executions>
					<execution>
						<id>unpack-test-model</id>
						<phase>generate-test-resources</phase>
						<goals>
							<goal>unpack</goal>
						</goals>
						<configuration>
							<!-- UML model and profiles used by the tests -->
							<artifactItems>
								<artifactItem>
									<groupId>com.anaptecs.jeaf.uml</groupId>
									<artifactId>jeaf-uml-test-model</artifactId>
									<version>${jeaf-uml-test-model.version}</version>
									<type>zip</type>
								</artifactItem>
							</artifactItems>
							<!-- Directory where the test model is unpacked to -->
							<outputDirectory>${project.build.directory}/test-model</outputDirectory>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
